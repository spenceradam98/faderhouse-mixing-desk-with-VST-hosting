<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Faderhouse @VERSION@</title>
    <welcome file="welcome.txt"/>
    <options customize="allow" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="10.15"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
        <line choice="strip"/>
    </choices-outline>
    <choice id="vst3" title="Faderhouse VST3" description="The 16-channel desk, for Ableton Live, FL Studio, Cubase, Reaper, Studio One, Max Sample and most other hosts.">
        <pkg-ref id="com.yourbrand.faderhouse.vst3"/>
    </choice>
    <choice id="au" title="Faderhouse Audio Unit" description="The 16-channel desk, for Logic Pro, GarageBand and MainStage.">
        <pkg-ref id="com.yourbrand.faderhouse.au"/>
    </choice>
    <choice id="app" title="Faderhouse Standalone app" description="Run the desk without a DAW: audio-interface inputs and VST3 instruments and effects on every channel.">
        <pkg-ref id="com.yourbrand.faderhouse.app"/>
    </choice>
    <choice id="strip" title="Faderhouse Strip (VST3 + AU)" description="One desk channel as an insert for a single track.">
        <pkg-ref id="com.yourbrand.faderhouse.strip-vst3"/>
        <pkg-ref id="com.yourbrand.faderhouse.strip-au"/>
    </choice>
    <pkg-ref id="com.yourbrand.faderhouse.vst3" version="@VERSION@">Faderhouse-vst3.pkg</pkg-ref>
    <pkg-ref id="com.yourbrand.faderhouse.au" version="@VERSION@">Faderhouse-au.pkg</pkg-ref>
    <pkg-ref id="com.yourbrand.faderhouse.app" version="@VERSION@">Faderhouse-app.pkg</pkg-ref>
    <pkg-ref id="com.yourbrand.faderhouse.strip-vst3" version="@VERSION@">Faderhouse-strip-vst3.pkg</pkg-ref>
    <pkg-ref id="com.yourbrand.faderhouse.strip-au" version="@VERSION@">Faderhouse-strip-au.pkg</pkg-ref>
</installer-gui-script>
